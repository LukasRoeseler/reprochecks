686
687  *** Dependent Means;
688  title "Means/ &outcome._&halfby._&gend._&top_bot";
689      proc genmod data=&halfby._&gend._&top_bot;
690          class school_id;
691          model &outcome=/link=id;
692          repeated subject=school_id /type=ind;
693
694      ods output GEEEmpPEst=means;
695      run;
696
697      data means;
698          set means;
699
700          length rowname $ 12;
701          length outcome $ 10;
702          outcome="&outcome";
703          rowname="0_dep_means";
704          if Parm="Intercept";
705          keep rowname outcome estimate;
706          rename estimate=c_&halfby._&gend._&top_bot;
707      run;
708
709      data trick;
710          length outcome $ 10;
711          length rowname $ 12;
712          length _NAME_ $ 12;
713      run;
714
715      data means;
716          set trick means;
717      run;
718
719  ********************************************************************;
720      *** OLS - main effect + linear control;
721
722  %macro reg(lg,name);
723  title "OLS/ &outcome._&halfby._&gend._&top_bot._&name";
724      ods output GEEEmpPEst=&halfby._&gend._&top_bot._&name;
725      ods output
725! ParameterEstimates=&halfby._&gend._&top_bot._&name._noclus;
726      ods output NObs=&halfby._&gend._&top_bot._N;
727      proc genmod data=&halfby._&gend._&top_bot descending;
728      class school_id_a school_id;
729      model &outcome=treated semarab semrel &lg
730                     year01 school_id /link=id;
731      repeated subject=school_id_a /type=ind ;
732      run;
733
734      Data &halfby._&gend._&top_bot._&name;
735      set &halfby._&gend._&top_bot._&name
736          (keep=parm Estimate StdErr);
737      length rowname $ 12;
738      length outcome $ 10;
739      outcome="&outcome";
740      rowname="&name";
741      if parm="treated";
742      keep rowname outcome estimate StdErr;
743      run;
744
745      data &halfby._&gend._&top_bot._&name._noclus;
746          set &halfby._&gend._&top_bot._&name._noclus
747              (keep=StdErr parameter);
748          if parameter="treated";
749          keep StdErr;
750          rename StdErr=NoClusSE;
751      run;
752
753
754  title "OLS-ROBUST/ &outcome._&halfby._&gend._&top_bot._&name";
755      ods output GEEEmpPEst=&halfby._&gend._&top_bot._&name._robust;
756      proc genmod data=&halfby._&gend._&top_bot descending;
757      class student_id school_id;
758      model &outcome=treated semarab semrel &lg
759                     year01 school_id /link=id;
760      repeated subject=student_id /type=ind ;
761      run;
762
763      Data &halfby._&gend._&top_bot._&name._robust;
764      set &halfby._&gend._&top_bot._&name._robust
765          (keep=parm StdErr);
766      if parm="treated";
767      keep StdErr;
768      rename StdErr=RobSE;
769      run;
770
771      Data &halfby._&gend._&top_bot._&name;
772          merge /* NO BYVAR REQUIRED! */
773                  &halfby._&gend._&top_bot._&name
774                  &halfby._&gend._&top_bot._&name._robust
775                  &halfby._&gend._&top_bot._&name._noclus;
776      run;
777
778      proc transpose data=&halfby._&gend._&top_bot._&name
778! out=&halfby._&gend._&top_bot._&name
779              (rename=(col1=c_&halfby._&gend._&top_bot));
780         by outcome rowname;
781      run;
782  %mend reg;
783  %reg (ls25--ls100,1_main);
784  %reg (lagscore,2_linear);
785
786  ********************************************************************;
787      *** Number of Observations;
788
789  data &halfby._&gend._&top_bot._N;
790  set &halfby._&gend._&top_bot._N;
791  if label="Number of Observations Used";
792          length rowname $ 12;
793          length outcome $ 10;
794          outcome="&outcome";
795          rowname="3_Number_Obs";
796  keep rowname N outcome;
797  rename
798      N=c_&halfby._&gend._&top_bot;
799  run;
800
801  data space1 space2 space3;
802      c_&halfby._&gend._&top_bot=.;
803  run;
