640  %macro base_halves (halfby,top_bot);
641
642  ********************************************************************;
643      *** Creating the top and bottom files;
644
645      DATA &halfby._&gend._&top_bot;
646      set base_&gend;
647      top=(&halfby.100=1);
648      bot=(&halfby.75 =1);
649      if &top_bot=1;
650
651      proc sort; by school_id;
652      proc summary; by school_id;
653      var year &outcome;
654      output out=temp min=minY j1 max=maxY j2 mean=j3 zak;
655      run;
656
657      DATA &halfby._&gend._&top_bot;
658      merge &halfby._&gend._&top_bot temp;
659      by school_id;
660      *** We make sure that each school appears in 2000 and 2001;
661      if minY=2000 and maxY=2001;
662      *** We also drop schools with no students eligible to Bagrut,
663          since these schools fail the school FE estimation;
664      run;
665
666  ********************************************************************;
667  %mend base_halves;
668
669  %base_halves (ls,top);
670  %base_halves (ls,bot);
671  %base_halves (p,top);
672  %base_halves (p,bot);
673  ********************************************************************;
674  %mend base_gender;
675
676  %base_gender (bg);
677  %base_gender (b);
678  %base_gender (g);
