**********************************************************************************************************************************************************************
**********************************************************************************************************************************************************************
	demog & religion
**********************************************************************************************************************************************************************
**********************************************************************************************************************************************************************
<page demog>
^^Vielen Dank! Hiermit ist der Hauptteil der Studie abgeschlossen.
^^Zum Schluss möchten wir Sie auf den folgenden Seiten bitten, einige Angaben zu Ihrer Person zu machen sowie Fragen zu Ihren Einstellungen zu beantworten.
</page>


** demog.

<textbox age>
/ caption = "Alter:"
/ required = false
</textbox>

<radiobuttons sex>
/ caption = "Geschlecht:"
/ options = ("weiblich", "männlich")
/ optionvalues = ("1", "2")
/ orientation = horizontal
</radiobuttons>

<radiobuttons bildung>
/ caption = "Bildungsabschluss:"
/ options = ("Hauptschule", "Realschule", "Gymnasium", "Universität", "keiner")
/ optionvalues = ("1", "2", "3", "4", "0", "9")
/ other = "sonstiger:"
</radiobuttons>

<textbox fach>
/ caption = "Studienfach bzw. Beruf"
/ required = false
</textbox>

<radiobuttons migration>
/ caption = "Haben Sie einen Migrationshintergrund?"
/ options = ("ja", "nein")
/ optionvalues = ("1", "0")
/ orientation = horizontal
</radiobuttons>

<textbox migration2>
/ caption = "Falls ja, aus welchem Land?"
/ required = false
</textbox>

<radiobuttons religion>
/ caption = "Welcher Religion sind Sie angehörig?"
/ options = ("Chr. Katholisch", "Chr. Evangelisch", "Muslimisch", "Jüdisch", "keiner")
/ optionvalues = ("1", "2", "3", "4", "0", "9")
/ other = "andere:"
</radiobuttons>



