***********************************
***** Suspicion Probe 1
***********************************



<textbox suspicion1>
/ caption = "1. Beschreiben Sie in Ihren eigenen Worten, worum es Ihrer Meinung nach in dieser Studie geht."
/ multiline = true
/ required = false
/ textboxsize = (30%, 50%)
</textbox>

<textbox suspicion2>
/ caption = "2. Glaubten Sie zu irgendeinem Zeitpunkt, dass die Studie etwas anderes untersucht, als das, was Ihnen mitgeteilt wurde?"
/ multiline = true
/ required = false
/ textboxsize = (30%, 20%)
</textbox>

<textbox suspicion3>
/ caption = "3. Beeinflusste dies Ihr Verhalten in irgendeiner Weise?"
/ multiline = true
/ required = false
/ textboxsize = (30%, 20%)
</textbox>

<textbox suspicion4>
/ caption = "4. Hatten Sie den Eindruck, dass bestimmte Reaktionen von Ihnen erwartet wurden?"
/ multiline = true
/ required = false
/ textboxsize = (30%, 20%)
</textbox>

<textbox suspicion5>
/ caption = "5. Welchen Zweck haben wir Ihrer Meinung nach mit der Beschreibung von David verfolgt?"
/ multiline = true
/ required = false
/ textboxsize = (30%, 20%)
</textbox>

<textbox suspicion6>
/ caption = "6. Welche Information zu David hielten Sie für relevant in Bezug auf die Studie?"
/ multiline = true
/ required = false
/ textboxsize = (30%, 20%)
</textbox>

<surveypage suspicion1>
/ caption = "Bevor wir Ihnen einige Fragen zu dem gelesenen Text stellen, möchten wir Sie um Feedback zu dem bisherigen Teil der Studie bitten. Wir möchten sicherstellen, dass der Aufbau der Studie stimmig ist und benötigen Ihre Rückmeldung, um uns bei der Verbesserung dieser Studie zu helfen. Bitte beantworten Sie die folgenden Fragen so ehrlich wie möglich. Ihre Antworten sind äußerst wichtig für die wissenschaftliche Gültigkeit dieser Studie. Antworten Sie bitte so ausführlich, wie es Ihrer Meinung nach notwendig ist, um die jeweilige Frage vollständig zu beantworten."
/ questions = [1=suspicion1]
/ finishlabel = "Weiter"
/ nextlabel = "Weiter"
/ showbackbutton = false
/ fontstyle = ("Arial", 2%)
/ showpagenumbers = false
/ nextbuttonposition = (90,90) 
/ showquestionnumbers = false
</surveypage>

<surveypage suspicion2>
/ caption = ""
/ questions = [1=suspicion2; 2=suspicion3; 3=suspicion4]
/ finishlabel = "Weiter"
/ nextlabel = "Weiter"
/ showbackbutton = false
/ fontstyle = ("Arial", 2%)
/ showpagenumbers = false
/ nextbuttonposition = (90,90) 
/ showquestionnumbers = false
</surveypage>

<surveypage suspicion3>
/ caption = ""
/ questions = [1=suspicion5; 2=suspicion6]
/ finishlabel = "Weiter"
/ nextlabel = "Weiter"
/ showbackbutton = false
/ fontstyle = ("Arial", 2%)
/ showpagenumbers = false
/ nextbuttonposition = (90,90) 
/ showquestionnumbers = false
</surveypage>

<block suspicion1>
/ trials = [1=suspicion1; 2=suspicion2; 3=suspicion3]
</block>




***********************************
***** Free Recall David
***********************************


<textbox mc_open>
/ caption = "Bitte beschreiben Sie David kurz in eigenen Worten."
/ multiline = true
/ required = false
/ textboxsize = (30%, 50%)
</textbox>

<surveypage mc_open>
/ caption = "Vielen Dank für Ihr Feedback! Es folgen nun einige Fragen zu David und dem gelesenen Text."
/ questions = [1=mc_open]
/ finishlabel = "Weiter"
/ nextlabel = "Weiter"
/ showbackbutton = false
/ fontstyle = ("Arial", 2%)
/ showpagenumbers = false
/ nextbuttonposition = (90,90) 
/ showquestionnumbers = false
</surveypage>

<block mc_open>
/ trials = [1=mc_open]
</block>


***********************************
***** Explizites Rating David
***********************************

<page david_fragen>
^^Bitte versuchen Sie nun, David anhand der Ihnen vorgegebenen Charaktereigenschaften einzuschätzen.
^^Es gibt hier keine richtigen und falschen Antworten, sondern nur Ihren persönlichen Eindruck, den Sie von David bekommen haben.
^^Klicken Sie bitte diejenige Antwort an, die Ihrer Meinung nach am ehesten auf David zutrifft. 
^^Wählen Sie die „1“, wenn die Antwort „überhaupt nicht“ zutrifft und die „5“, wenn sie „sehr stark“ zutrifft. Nutzen Sie die Optionen dazwischen, um Ihr Urteil abzustufen. 
</page>

<text david_fragen>
/items = david_fragen
/ fontstyle = ("Arial", 4%)
/ select = sequence
/ position = (50,50)
</text>

<text davidreminder>
/ halign = left
/ fontstyle = ("Arial", 3%)
/ items = ("Inwiefern trifft die folgende Eigenschaft auf David zu?")
/ position = (10,20)
</text>

<item david_fragen>
/	1	=	"selbstsicher"
/	2	=	"einsam"
/	3	=	"intelligent"
/	4	=	"warm"
/	5	=	"phantasievoll"
/	6	=	"aufrichtig"
/	7	=	"wissbegierig"
/	8	=	"freundlich"
/	9	=	"lebhaft"
/	10	=	"gesetzestreu "
/	11	=	"kompetent"
/	12	=	"gutmütig"
/	13	=	"besorgt "
/	14	=	"tüchtig"
/	15	=	"gesellig "
/	16	=	"ehrlich"
/	17	=	"ängstlich"
/	18	=	"unabhängig"
/	19	=	"ruhig "
/	20	=	"vertrauenswürdig"
</item>



<likert david_fragen>
/ stimulustimes = [1=david_fragen]
/ anchors = [1="gar nicht"; 2=""; 3=""; 4=""; 5="sehr"]
/ anchorwidth = 180
/ numpoints = 5
/ fontstyle = ("Arial", 2%)
/ position = (50, 70)
/ mouse=true
</likert>

<block david_fragen>
/ bgstim = (davidreminder)
/ preinstructions = (david_fragen)
/ trials = [1-20 = david_fragen]
</block>







******************************************************
********** Manipulation Check *****************
******************************************************



<radiobuttons mc_a>
/ caption = "1. David lebt in"
/ options = ("Dortmund", "Düsseldorf","Dormagen","Detmold")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>

<radiobuttons mc_b>
/ caption = "2. David hält Vorträge zu"
/ options = ("Kindererziehung", "seiner Arbeit in der Künstleragentur","jüdischer Musik","Umweltschutz")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>

<radiobuttons mc_c>
/ caption = "3. David hat studiert:"
/ options = ("Jura", "BWL","Musik","Politik")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>

<radiobuttons mc_d>
/ caption = "4. David arbeitet ehrenamtlich in einer Organisation für"
/ options = ("Opferschutz", "die Bewahrung des Waldes","Nachkommen von Holocaustüberlebenden","krebskranke Kinder")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>


<radiobuttons mc_e>
/ caption = "5. David lebt in"
/ options = ("einer Wohnung", "einer Waldhütte","einem Haus","einer Wohngemeinschaft")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>

<radiobuttons mc_f>
/ caption = "6. David ist"
/ options = ("Moslem", "Christ","Jude","Buddhist")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>

<radiobuttons mc_g>
/ caption = "7. Davids Aufgabe im Hilfsprojekt ist"
/ options = ("Spenden verwalten", "Informationsabende organisieren","Gitarre spielen","Info-Material gestalten")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>

<radiobuttons mc_h>
/ caption = "8. David spielt"
/ options = ("Gitarre", "Bass","Geige","Klarinette")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>

<radiobuttons mc_i>
/ caption = "9. Davids Sohn heißt"
/ options = ("Stefan", "Sven","Simon","Sebastian")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>

<radiobuttons mc_j>
/ caption = "10. David engagiert sich"
/ options = ("in der Kirche", "im Fußballverein","in der Synagoge","im Kindergarten")
/ optionvalues = ("1", "2","3","4")
</radiobuttons>


<surveypage mc_1>
/ caption = "Bitte erinnern Sie sich nun an den Text über David und wählen Sie zu jeder Aussage die richtige Option aus."
/ questions = [1=mc_a; 2=mc_b; 3=mc_c; 4=mc_d]
/ finishlabel = "Weiter"
/ nextlabel = "Weiter"
/ showbackbutton = false
/ fontstyle = ("Arial", 2.5%, true)
/ itemfontstyle = ("Arial", 2%)
/ showpagenumbers = false
/ nextbuttonposition = (90,90) 
/ showquestionnumbers = false
</surveypage>

