***********************************
***** Suspicion Probe 1
***********************************



<textbox suspicion1>
/ caption = "1. Beschreiben Sie in Ihren eigenen Worten, worum es Ihrer Meinung nach in dieser Studie geht."
/ multiline = true
/ required = false
/ textboxsize = (50%, 20%)
</textbox>

<textbox suspicion2>
/ caption = "2. Hatten Sie den Eindruck, dass bestimmte Reaktionen von Ihnen erwartet wurden? Wenn ja, welche?"
/ multiline = true
/ required = false
/ textboxsize = (50%, 15%)
</textbox>


<surveypage suspicion1>
/ caption = "Bevor es mit dem nächsten Teil weiter geht, möchten wir Sie um Feedback zu dem bisherigen Teil der Studie bitten. Wir möchten sicherstellen, dass der Aufbau der Studie stimmig ist und benötigen Ihre Rückmeldung, um uns bei der Verbesserung künftiger Studien zu helfen. Bitte beantworten Sie die folgenden Fragen so ehrlich wie möglich. Ihre Antworten sind äußerst wichtig für die wissenschaftliche Gültigkeit dieser Studie. Antworten Sie bitte so ausführlich, wie es Ihrer Meinung nach notwendig ist, um die jeweilige Frage vollständig zu beantworten."
/ questions = [1=suspicion1; 2=suspicion2]
/ finishlabel = "Weiter"
/ nextlabel = "Weiter"
/ showbackbutton = false
/ fontstyle = ("Arial", 2%)
/ showpagenumbers = false
/ nextbuttonposition = (90,90) 
/ showquestionnumbers = false
</surveypage>

<block suspicion1>
/ trials = [1=suspicion1]
</block>



***********************************
***** Explizites Rating David
***********************************

<page david_fragen>
^^Welchen ersten Eindruck haben Sie von David S. bekommen?
^^Es gibt bei den nun folgenden Fragen keine richtigen und falschen Antworten, sondern nur Ihren persönlichen Eindruck, den Sie von David S. bekommen haben.
</page>

<text david_fragen>
/items = david_fragen
/ fontstyle = ("Arial", 3%)
/ select = sequence
/ position = (50,50)
</text>



<item david_fragen>
/1	= "Wie sehr würden Sie David S. wohl mögen?"
/2	= "Wie sympathisch erscheint Ihnen David S.?"
/3 = "Wie berechnend erscheint Ihnen David S.?"
/4 = "Wie geizig erscheint Ihnen David S.?"
/5 = "Wie warmherzig erscheint Ihnen David S.?"
/6 = "Wie gerissen erscheint Ihnen David S.?"
/7 = "Wie vertrauenswürdig erscheint Ihnen David S.?"
/8 = "Wie rücksichtslos erscheint Ihnen David S.?"
/9 = "Wie skrupellos erscheint Ihnen David S.?"
/10 = "Wie ehrlich erscheint Ihnen David S.?"
</item>



<likert david_fragen>
/ stimulustimes = [1=david_fragen]
/ anchors = [1="gar nicht"; 2=""; 3=""; 4=""; 5=""; 6=""; 7="sehr"]
/ anchorwidth = 5%
/ numpoints = 7
/ fontstyle = ("Arial", 1.5%, false)
/ position = (50, 70)
/ mouse=true
</likert>

<block david_fragen>
/ preinstructions = (david_fragen)
/ trials = [1-10 = david_fragen]
/ postinstructions = (wsc_pre)
</block>




<page wsc_pre>
^^Da wir uns in dieser Studie für Ihre Erinnerungsleistung interessieren, folgt nun eine kurze Pause, bevor es mit dem letzten Teil der eigentlichen Studie weiter geht.
^^In dieser Zeit möchten wir Sie bitten, die folgende Wortstammergänzungsaufgabe zu bearbeiten.
^^Diese dient zur Erstellung von Untersuchungsmaterial für zukünftige Forschungsprojekte.
^^Bitte klicken Sie jetzt auf "Weiter" um mit der Wortstammergänzungsaufgabe zu beginnen.
</page>

